# =============================================================================
# INFIVERSE BHL - CENTRALIZED DEV/PRODUCTION INFRASTRUCTURE CONFIGURATION
# =============================================================================
#
# Instructions:
# 1. Copy this file to a new file named .env in this root directory.
# 2. Update the credentials, URLs, and secrets as required.
# 3. Spin up the entire infrastructure using: docker compose up -d
#
# =============================================================================

# --------------------------------------
# 1. Host Infrastructure Settings
# --------------------------------------
NODE_ENV=production

# Exposed Ports on Host Machine
HOST_FRONTEND_PORT=80
HOST_BACKEND_PORT=5000
HOST_MONGO_PORT=27017

# --------------------------------------
# 2. Database (MongoDB Container) Settings
# --------------------------------------
# Internal docker-compose network connection string
MONGODB_URI=mongodb://database:27017/niyantran

# --------------------------------------
# 3. Security & CORS (Backend Container)
# --------------------------------------
# Absolute URL of the served frontend client (e.g. your Neysa/Yotta IP or domain)
FRONTEND_URL=http://163.128.209.18

# CORS Allowed Origin (should match FRONTEND_URL)
CORS_ORIGIN=http://163.128.209.18

# Secret key for JWT signing
JWT_SECRET=b654084fa30113fdbb99d5daee60cf56372d8ebf9c73

# --------------------------------------
# 4. Frontend Client Environment Settings
# --------------------------------------
# Public API Endpoint accessed by the client from the browser
# In docker-compose, this is mapped via the host port to /api of the backend.
VITE_API_URL=http://163.128.209.18/api

# Push Notification Keys
VITE_VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>

# --------------------------------------
# 5. External API Services
# --------------------------------------
# Google AI API Key (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Groq AI Service Key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary Integration (for Screen Capture Storage to bypass local disk limits)
CLOUDINARY_STORAGE_ENABLED=true
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Service (Nodemailer config for system/HR emails)
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
