# Backend API URL for the employee agent
AGENT_API_BASE_URL=http://localhost:5000

# OPTIONAL: Zero-touch automatic login credentials
# (If left empty, logging in once in the app saves your credentials permanently)
AGENT_AUTO_LOGIN_EMAIL=
AGENT_AUTO_LOGIN_PASSWORD=

# Run quietly in the background (system tray) without popping up a window
AGENT_START_MINIMIZED=true

# Launch automatically on Windows computer startup
AGENT_AUTO_START_ON_BOOT=true
