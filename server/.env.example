# =============================================================================
# INFIVERSE - AI WORKFLOW MANAGEMENT SYSTEM
# Environment Configuration Template
#
# Instructions:
# 1. Copy this file to a new file named .env in the same directory.
# 2. Fill in the placeholder values with your actual credentials and settings.
# 3. Do NOT commit the .env file to version control.
# =============================================================================

# --------------------------------------
# Core Application Settings
# --------------------------------------
NODE_ENV=production
PORT=5000
# The frontend URL is used for CORS and in email links.
# Use http://localhost:5173 for local development.
FRONTEND_URL=https://blackhole-workflow.vercel.app
# --------------------------------------
# Database & JWT
# --------------------------------------
# Your MongoDB connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/your-db-name

# A long, random, and secret string for signing JSON Web Tokens.
JWT_SECRET=your-super-secret-jwt-key

# Required for the TANTRA execution gateway integration.
TANTRA_EXECUTION_KEY=your-tantra-execution-key

# --------------------------------------
# Google OAuth Configuration
# --------------------------------------
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --------------------------------------
# Security & CORS
# --------------------------------------
# CORS Allowed Origin (should match FRONTEND_URL). Comma-separated origins supported.
# Production VM: set these in GitHub ENV_FILE to the browser origin (IP or domain).
CORS_ORIGIN=https://blackhole-workflow.vercel.app

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------
# Email Service (Nodemailer)
# --------------------------------------
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password

# --------------------------------------
# Cloudinary (for Screen Capture Storage)
# --------------------------------------
CLOUDINARY_STORAGE_ENABLED=true
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --------------------------------------
# Web Push Notifications (VAPID Keys)
# --------------------------------------
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# --------------------------------------
# AI Services
# --------------------------------------
AI_ANALYSIS_ENABLED=true
MAX_AI_RETRIES=3

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# Groq AI Service (for AI Insights & Optimization)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --------------------------------------
# Employee Monitoring & Attendance
# --------------------------------------
# General Monitoring
BROWSER_MONITORING_ENABLED=true
ACTIVITY_TRACKING_INTERVAL=60000
ACTIVITY_FLUSH_INTERVAL=30000
IDLE_THRESHOLD=900000

# Browser & Website Monitoring
BROWSER_CHECK_INTERVAL=5000
WEBSITE_MONITORING_INTERVAL=8000
BROWSER_CACHE_TIMEOUT=2000
BROWSER_RATE_LIMIT=1000

# Screen Capture Settings
SCREEN_CAPTURE_INTERVAL=300000
COMPRESSION_QUALITY=80
SCREENSHOT_QUALITY=80
MAX_SCREENSHOT_SIZE=5242880
SCREENSHOT_MAX_SIZE=1920x1080
SCREENSHOT_STORAGE_PATH=./uploads/employee_data
ENABLE_LOCAL_BACKUP=false

# Attendance & Geolocation
AUTO_END_DAY_ENABLED=true
MAX_WORKING_HOURS=8
OFFICE_LAT=19.160122
OFFICE_LNG=72.839720
OFFICE_RADIUS=2000
OFFICE_ADDRESS="Blackhole Infiverse, Kali Gali, 176/1410, Rd Number 3, near Hathi Circle, above Bright Connection, Motilal Nagar II, Goregaon West, Mumbai, Maharashtra 400104"

# --------------------------------------
# Logging
# --------------------------------------
LOG_LEVEL=info
ENABLE_PERFORMANCE_LOGS=false

# --------------------------------------
# TANTRA Execution Gateway
# --------------------------------------
# Required at startup — server will not boot without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TANTRA_EXECUTION_KEY=your-tantra-execution-key

# --------------------------------------
# BHIV Bucket Integration (Additive — existing Cloudinary untouched)
# --------------------------------------
# Bucket is deployed on Render. No API key needed.
BUCKET_BASE_URL=https://bhiv-bucket-i1l6.onrender.com
# Optional: API key for service-to-service auth (x-api-key header).
# Leave empty if Bucket has no auth (current Render deployment).
# BUCKET_API_KEY=
# HTTP timeout in milliseconds for Bucket calls.
# Higher for Render (cold starts can take several seconds).
BUCKET_TIMEOUT_MS=10000

# --------------------------------------
# BHIV PRANA Integration (NOT DEPLOYED — git repo only)
# --------------------------------------
# PRANA is provided as a reference repo for future integration.
# Session-telemetry endpoint does not exist yet (B6 gap).
# Uncomment these when PRANA is deployed:
# PRANA_BASE_URL=
# PRANA_API_KEY=

# --------------------------------------
# PARIKSHAK Integration
# --------------------------------------
# URL of the running Parikshak FastAPI service.
# Local dev: http://localhost:8000
# Production VM: http://163.128.209.18:8000 (or your deployed host)
PARIKSHAK_URL=http://localhost:8000
